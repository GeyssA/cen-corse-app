{
  "name": "mon-projet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:mobile": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:prod": "npm run clean && npm run type-check && npm run lint && next build && node scripts/clean-production.js",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next out",
    "prebuild": "npm run clean",
    "test:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "optimize:images": "node scripts/optimize-images.js",
    "bundle:analyze": "npx @next/bundle-analyzer",
    "pwa:audit": "lighthouse http://localhost:3000 --only-categories=pwa --output html",
    "analyze:performance": "node scripts/analyze-performance.js",
    "fix:eslint": "npm run lint -- --fix",
    "optimize:all": "npm run optimize:images && npm run fix:eslint && npm run build",
    "generate-favicon": "node scripts/generate-favicon.js",
    "preview": "next build && next start",
    "build:capacitor": "node scripts/prepare-capacitor-build.js && node scripts/inject-capacitor-fixes.js && npx cross-env CAPACITOR_BUILD=true npm run build && node scripts/restore-api-routes.js && node scripts/revert-capacitor-fixes.js && npx cap sync android",
    "build:apk": "npm run build:capacitor && node scripts/build-android-release.js assembleRelease",
    "build:aab": "npm run build:capacitor && node scripts/build-android-release.js bundleRelease",
    "build:fresh": "node scripts/build-fresh-apk-aab.js",
    "run:android": "npx cap run android",
    "emulator": "npm run build:capacitor && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/status-bar": "^7.0.3",
    "capacitor-audio-permission": "^0.7.0",
    "@capgo/capacitor-navigation-bar": "^7.0.0",
    "@emailjs/browser": "^4.4.1",
    "@react-google-maps/api": "^2.20.7",
    "@supabase/supabase-js": "^2.43.5",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "framer-motion": "^12.23.24",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.16.0",
    "next": "15.3.6",
    "react": "^19.0.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.6",
    "lighthouse": "^12.0.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
