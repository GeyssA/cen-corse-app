# Configuration du keystore pour la signature de l'app
# Copiez ce fichier vers keystore.properties et remplissez les valeurs
# ⚠️ IMPORTANT : Ne commitez JAMAIS keystore.properties dans git !

storeFile=../app/your-keystore.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password










