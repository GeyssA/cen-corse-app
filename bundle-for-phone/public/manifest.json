{
  "name": "CEN Corse - Plateforme de collaboration",
  "short_name": "CEN Corse",
  "description": "Application de gestion des projets et activités communautaires du CEN Corse",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1e3a8a",
  "theme_color": "#1e3a8a",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "fr",
  "id": "cen-corse-app",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "categories": ["productivity", "business", "education", "nature"],
  "dir": "ltr",
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/playstore-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/playstore-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/playstore-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "apple-touch-icon"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Vue d'ensemble de la plateforme"
    },
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Interface mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Nouveau projet",
      "short_name": "Projet",
      "description": "Créer un nouveau projet",
      "url": "/projets?create=true",
      "icons": [
        {
          "src": "/playstore-icon.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Nouvelle activité",
      "short_name": "Activité",
      "description": "Créer une nouvelle activité",
      "url": "/communaute?create=true",
      "icons": [
        {
          "src": "/playstore-icon.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Statistiques",
      "short_name": "Stats",
      "description": "Voir les statistiques",
      "url": "/statistiques",
      "icons": [
        {
          "src": "/playstore-icon.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "related_applications": [],
  "protocol_handlers": [
    {
      "protocol": "web+cen-corse",
      "url": "/projet?id=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf", ".doc", ".docx"]
        }
      ]
    }
  }
}